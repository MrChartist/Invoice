{
  "name": "mrchartist-invoice",
  "private": true,
  "version": "3.0.0",
  "description": "Free, open-source, offline-first invoicing and light accounting for Indian businesses — GST-ready, private by design.",
  "author": "Rohit Singh <mrchartist@zohomail.in>",
  "homepage": "https://mrchartist.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/gen-precache.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --import ./tests/hooks/register.mjs --test \"tests/**/*.test.ts\"",
    "preview": "vite preview",
    "check:size": "node scripts/check-bundle-size.mjs",
    "verify:offline": "node scripts/verify-offline.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "uuid": "^14.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": ">=22"
  }
}

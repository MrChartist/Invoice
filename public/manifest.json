      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/json",
            ".json",
            "text/plain",
            ".txt",
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/gif",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".gif",
            "application/pdf",
            ".pdf",
            "text/csv",
            ".csv",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".xlsx"
          ]
        }
      ]
    }
  }
